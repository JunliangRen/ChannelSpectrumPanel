#include <windows.h>
#include "resource.h"
IDD_SETTINGS DIALOGEX 0,0,510,480
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Channel Spectrum Mirror"
FONT 9,"Segoe UI"
BEGIN
 LTEXT "Refresh ms (5-100)",-1,10,14,140,12
 EDITTEXT IDC_INTERVAL,153,12,60,14,ES_NUMBER | WS_TABSTOP
 LTEXT "Peak fall (1-99)",-1,10,34,140,12
 EDITTEXT IDC_FALL,153,32,60,14,ES_NUMBER | WS_TABSTOP
 LTEXT "Peak hold ms",-1,10,54,140,12
 EDITTEXT IDC_HOLD,153,52,60,14,ES_NUMBER | WS_TABSTOP
 LTEXT "Range (1-1000)",-1,10,74,140,12
 EDITTEXT IDC_RANGE,153,72,60,14,ES_NUMBER | WS_TABSTOP
 LTEXT "Bar width (1-8)",-1,10,94,140,12
 EDITTEXT IDC_WIDTH,153,92,60,14,ES_NUMBER | WS_TABSTOP
 LTEXT "Spacing (0-8)",-1,10,114,140,12
 EDITTEXT IDC_SPACING,153,112,60,14,ES_NUMBER | WS_TABSTOP
 LTEXT "Left padding",-1,10,134,140,12
 EDITTEXT IDC_PADLEFT,153,132,60,14,ES_NUMBER | WS_TABSTOP
 LTEXT "Right padding",-1,10,154,140,12
 EDITTEXT IDC_PADRIGHT,153,152,60,14,ES_NUMBER | WS_TABSTOP
 LTEXT "Channel padding",-1,10,174,140,12
 EDITTEXT IDC_GAP,153,172,60,14,ES_NUMBER | WS_TABSTOP
 LTEXT "Blur level (0-100%)",-1,10,194,140,12
 EDITTEXT IDC_BLUR,153,192,60,14,ES_NUMBER | WS_TABSTOP
 LTEXT "Speaker position (1-18)",-1,10,214,140,12
 EDITTEXT IDC_SELECTED,153,212,60,14,ES_NUMBER | WS_TABSTOP
 LTEXT "Frequency short tick",-1,10,234,140,12
 EDITTEXT IDC_FSHORT,153,232,60,14,ES_NUMBER | WS_TABSTOP
 LTEXT "Frequency long tick",-1,10,254,140,12
 EDITTEXT IDC_FLONG,153,252,60,14,ES_NUMBER | WS_TABSTOP
 LTEXT "Amplitude short tick",-1,10,274,140,12
 EDITTEXT IDC_ASHORT,153,272,60,14,ES_NUMBER | WS_TABSTOP
 LTEXT "Amplitude long tick",-1,10,294,140,12
 EDITTEXT IDC_ALONG,153,292,60,14,ES_NUMBER | WS_TABSTOP
 LTEXT "FFT size",-1,230,14,108,12
 COMBOBOX IDC_FFT,339,12,160,110,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
 LTEXT "Drawing style",-1,230,37,108,12
 COMBOBOX IDC_STYLE,339,35,160,110,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
 LTEXT "Direction",-1,230,60,108,12
 COMBOBOX IDC_DIRECTION,339,58,160,110,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
 LTEXT "Rotation clockwise",-1,230,83,108,12
 COMBOBOX IDC_ROTATION,339,81,160,110,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
 LTEXT "Channel mode",-1,230,106,108,12
 COMBOBOX IDC_CHANNELMODE,339,104,160,110,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
 LTEXT "Panel edge",-1,230,129,108,12
 COMBOBOX IDC_EDGE,339,127,160,110,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
 CONTROL "New FFT normalization",IDC_NEWFFT,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,230,153,137,17
 CONTROL "Logarithmic amplitude",IDC_LOGAMP,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,454,153,137,17
 CONTROL "Linear frequency",IDC_LINEAR,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,230,173,137,17
 CONTROL "Reverse frequency axis",IDC_REVFREQ,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,454,173,137,17
 CONTROL "Reverse channel positions",IDC_REVCHAN,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,230,193,137,17
 CONTROL "Show peaks (also in line mode)",IDC_PEAKS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,454,193,137,17
 CONTROL "Segmented bars",IDC_SEGMENTED,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,230,213,137,17
 CONTROL "Frequency ticks (2 kHz)",IDC_FTICKS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,454,213,137,17
 CONTROL "Amplitude ticks (relative)",IDC_ATICKS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,230,233,137,17
 CONTROL "Separate: use all input channels",IDC_ALLCHANNELS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,454,233,137,17
 LTEXT "Foreground 1 (RGB hex)",-1,230,258,90,12
 EDITTEXT IDC_FG,230,270,80,14,ES_AUTOHSCROLL | WS_TABSTOP
 LTEXT "Foreground 2 (RGB hex)",-1,320,258,90,12
 EDITTEXT IDC_FG2,320,270,80,14,ES_AUTOHSCROLL | WS_TABSTOP
 LTEXT "Background (RGB hex)",-1,410,258,90,12
 EDITTEXT IDC_BG,410,270,80,14,ES_AUTOHSCROLL | WS_TABSTOP
 LTEXT "Peak color (RGB hex)",-1,230,294,90,12
 EDITTEXT IDC_PEAKCOLOR,230,306,80,14,ES_AUTOHSCROLL | WS_TABSTOP
 LTEXT "Tick color (RGB hex)",-1,320,294,90,12
 EDITTEXT IDC_TICKCOLOR,320,306,80,14,ES_AUTOHSCROLL | WS_TABSTOP
 LTEXT "Channel order: speaker positions 1-18, comma separated",-1,10,318,290,12
 EDITTEXT IDC_ORDER,10,333,370,16,ES_AUTOHSCROLL | WS_TABSTOP
 LTEXT "Active speaker mask (hex)",-1,390,318,110,12
 EDITTEXT IDC_ACTIVEMASK,390,333,108,16,ES_AUTOHSCROLL | WS_TABSTOP
 CONTROL "Parent background",IDC_TRANSPARENT,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,10,359,125,12
 CONTROL "Cache parent background",IDC_FASTTRANS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,145,359,150,12
 CONTROL "Scanline sync (experimental)",IDC_SCANLINE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,310,359,190,12
 CONTROL "Use foreground palette (8 RGB hex colors, low to high)",IDC_FGPALETTE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,10,380,360,12
 EDITTEXT IDC_FGCOLORS,10,394,488,15,ES_AUTOHSCROLL | WS_TABSTOP
 CONTROL "Use background palette (8 RGB hex colors, bottom to top)",IDC_BGPALETTE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,10,415,370,12
 EDITTEXT IDC_BGCOLORS,10,429,488,15,ES_AUTOHSCROLL | WS_TABSTOP
 PUSHBUTTON "Defaults",IDC_RESET,10,454,58,16
 PUSHBUTTON "Import...",IDC_IMPORT,75,454,58,16
 PUSHBUTTON "Export...",IDC_EXPORT,140,454,58,16
 PUSHBUTTON "Apply",IDC_APPLY,305,454,58,16
 DEFPUSHBUTTON "OK",IDOK,370,454,58,16
 PUSHBUTTON "Cancel",IDCANCEL,435,454,63,16
END
